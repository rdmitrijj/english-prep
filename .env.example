# Copy to .env and fill in. Never commit .env.
# Local dev: docker-compose.yml already sets DATABASE_URL, JWT_SECRET and COOKIE_SECURE.

# --- core ---
# Neon: use the *direct* (non-pooled) URL; replace "sslmode=require&channel_binding=require" with "ssl=require".
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=7
# false only for local http
COOKIE_SECURE=true

# --- AI (used from M2 on) ---
OPENAI_API_KEY=
LLM_MODEL_GENERATE=gpt-6.1-sol
LLM_MODEL_EVALUATE=gpt-6.1-sol
LLM_MODEL_VERIFY=gpt-5.6-terra
AI_CALLS_PER_HOUR=10
DEFAULT_MONTHLY_AI_BUDGET_USD=10

# --- TTS (content build, M5) ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# --- Speaking (M10, optional) ---
FEATURE_SPEAKING=false
REALTIME_MODEL=gpt-realtime-2.1

# dev only: 0.05 shrinks a 60-minute section to 3 minutes
EXAM_TIME_SCALE=1
# dev only: move the server clock this many days ahead to see spaced-repetition reviews fall due
DEV_CLOCK_OFFSET_DAYS=0

LOG_LEVEL=info
